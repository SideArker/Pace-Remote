{
  "name": "@pace-remote/android",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "build:bundle": "expo prebuild --platform android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@pace-remote/protocol": "file:../../packages/protocol",
    "expo": "~57.0.29",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.6.7",
    "pace-lan": "file:./modules/pace-lan"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2"
  }
}
