{
  "name": "@pace-remote/android",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "build:bundle": "expo prebuild --platform android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@pace-remote/protocol": "1.0.0",
    "expo": "~57.0.29",
    "expo-router": "~57.0.27",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": { "@types/react": "~19.2.2", "eslint": "^9.0.0", "eslint-config-expo": "~57.0.2" }
}
